# ── Copy this to .env and fill in values ─────────────────────
# cp .env.example .env

# ── Azure credentials ─────────────────────────────────────────
# Same SP as devops-platform-foundation
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-sp-appId
AZURE_CLIENT_SECRET=your-sp-password

# ── AI (Groq — free tier) ─────────────────────────────────────
GROQ_API_KEY=gsk_your-key-here

# ── GitHub ────────────────────────────────────────────────────
# PAT with repo scope — for creating draft PRs
GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPO=vmprachi7/security-auditor

# ── Scanner settings ──────────────────────────────────────────
# Days of Azure Monitor logs to check for dependency analysis
DEPENDENCY_LOOKBACK_DAYS=30

# Set to true to use mock data (no Azure credentials needed)
USE_MOCK_DATA=true
